# Environment configuration. Copy this file to `.env.local` and fill in real
# values (`.env.local` is gitignored). All six variables are required: the app
# validates them at import via lib/env.ts and fails fast — there are no
# code-side defaults. See README for where each value comes from per
# environment (local `supabase status` vs hosted Dashboard).

# Database connection used by the Next.js server and tests. For local
# development, use the connection details for the stack started by
# `npm run db:start`.
DATABASE_URL=your-database-connection-string

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authorizes the nightly finding-image cleanup cron (Vercel Cron). Generate a
# real value locally, e.g. `openssl rand -base64 32`.
CRON_SECRET=your-vercel-cron-secret

# User-triggered writes are enabled locally and in integration tests only.
# Must be exactly `true` or `false`.
MUTATIONS_ENABLED=true
