# Supabase client configuration. Copy this file to `.env.local` and fill in
# real values (`.env.local` is gitignored). See README for where each value
# comes from per environment (local `supabase status` vs hosted Dashboard).

# Database connection used by the Next.js server and tests. For local
# development, use the connection details for the stack started by
# `npm run db:start`.
DATABASE_URL=your-database-connection-string

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=your-vercel-cron-secret

# User-triggered writes are enabled locally and in integration tests only.
MUTATIONS_ENABLED=true

# Upstash Redis for rate limiting. Required for production; falls back to
# in-memory when not set (local dev only). Get values from Upstash Console
# → Redis → REST API.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
