{
  "name": "seminar-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:start": "(supabase status >/dev/null 2>&1 || supabase start)",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:prepare": "npm run db:start && supabase db reset && next build",
    "test": "npm run test:prepare && vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "next": "^16.3.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.115.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "24.14.0"
  }
}
