    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.117.0",
